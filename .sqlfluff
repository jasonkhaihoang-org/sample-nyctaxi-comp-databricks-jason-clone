[sqlfluff]
templater = jinja
dialect = databricks
max_line_length = 120
exclude_rules = AL01, AM05, ST06, ST09, RF02, RF06, LT09

# The jinja templater renders without a warehouse or a profile. It loads the project's
# macros, except source_defer.sql: that one calls dbt's `builtins`, which only dbt has.
[sqlfluff:templater:jinja]
apply_dbt_builtins = True
load_macros_from_path = transformation/macros/finance.sql,transformation/macros/generate_schema_name.sql,transformation/macros/timestamps.sql,transformation/macros/trip_keys.sql
