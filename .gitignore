# ---------------------------------------------------------------
# Source data. Fetched by the dlt pipelines in ingestion/ from TLC open data.
# Never commit trip parquet -- it is large and freely downloadable.
# ---------------------------------------------------------------
raw/
*.parquet
*.csv.gz

# ---------------------------------------------------------------
# Warehouse. Rebuilt by orchestration/run_all.py.
# ---------------------------------------------------------------
*.duckdb
*.duckdb.wal
*.db
*.sqlite

# ---------------------------------------------------------------
# Transformation build artefacts
# ---------------------------------------------------------------
transformation/target/
transformation/logs/
transformation/dbt_packages/
**/.user.yml
logs/
target/
dbt_packages/
*.log

# ---------------------------------------------------------------
# Local tooling
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.env
.DS_Store
.pytest_cache/
.agents_tmp/
.idea/
.vscode/

# Secrets. Never commit; dlt reads them from the bound secret store.
**/secrets.toml

# Seed CSVs are project config, not data -- keep them.
!transformation/seeds/*.csv


# Generated by the dlt preview script on every sample load
ingestion/last-run-preview.md
.ruff_cache/

# Local plan-execution scratch
.superpowers/
